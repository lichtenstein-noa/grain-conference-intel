# Copy this file to .env.local and fill in your own values.
#
# Supabase: Project Settings -> API in the Supabase dashboard.
# The anon / publishable key is designed to be exposed in a browser - it is not
# a secret. NEVER put the service_role / secret key in here; it bypasses RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Deliberately NO Anthropic key here.
#
# Vite inlines every VITE_* variable into the JavaScript bundle it ships, so a
# key set this way would be published to every visitor of the deployed site.
# The app asks each user for their own key in Settings and keeps it in their
# browser's localStorage instead - which is also what the brief asks for:
# "API keys should be configurable by the user, not hardcoded into the source."
